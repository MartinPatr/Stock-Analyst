# Copy to .env and edit. Every value is optional; defaults shown.

# SQLite database holding scan snapshots.
DB_PATH=data/stockchecker.db

# Discord bot token (required only for `python -m stockchecker.bot`).
# Create one at https://discord.com/developers/applications and never commit it.
DISCORD_TOKEN=

# Minimum seconds between requests to the same host (be polite to the sites we scrape).
REQUEST_DELAY_S=1.0

# Parallel tickers processed during `stockchecker scan`.
MAX_WORKERS=4

# Ticker universe: one `TICKER,Company Name,Exchange` per line.
UNIVERSE_FILE=data/tickers.txt

LOG_LEVEL=INFO
